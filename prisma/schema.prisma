generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VentLog {
  id         String   @id @default(uuid()) @db.Uuid
  content    String
  aiResponse String   @map("ai_response")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("vent_logs")
}

model ResilienceLog {
  id           String   @id @default(uuid()) @db.Uuid
  scenario     String
  userResponse String   @map("user_response")
  aiFeedback   String   @map("ai_feedback")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("resilience_logs")
}

model QuizScore {
  id        String   @id @default(uuid()) @db.Uuid
  score     Int
  total     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("quiz_scores")
}
